{
  "name": "wayfare",
  "version": "0.0.0",
  "private": true,
  "description": "Wayfare — a trip planned for you from one sentence.",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm -r build",
    "build:single": "VITE_USE_MOCKS=0 pnpm -r build",
    "start": "pnpm --filter @wayfare/server start",
    "serve": "pnpm build:single && pnpm start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  }
}
