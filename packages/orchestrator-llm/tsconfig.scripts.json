{
  // The build tsconfig pins rootDir to ./src so dist/ stays flat. Scripts run through tsx and are
  // never emitted, so they get their own no-emit project. Otherwise nothing would typecheck them.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["scripts/**/*", "src/**/*"],
  "exclude": ["dist", "node_modules"]
}
