{
  "name": "@wayfare/shared",
  "version": "0.1.0",
  "description": "Wayfare shared types + Zod schemas — the single source of truth for the API_CONTRACT wire.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
