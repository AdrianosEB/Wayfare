{
  "name": "@wayfare/orchestrator",
  "version": "0.1.0",
  "description": "Wayfare agent orchestration: agents that search providers in parallel, cross-check listings and prices across sources, match options to a traveler's budget and preferences, and re-check the plan before returning it.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "demo": "tsx src/demo.ts",
    "bench": "tsx bench/fanout.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@wayfare/shared": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.4"
  }
}
