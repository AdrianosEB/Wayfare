# Wayfare API server environment.
# Copy to .env for local dev. NEVER commit a real key (see NFR-4 — keys live server-side only).

# Anthropic API key. When set, the planning agent runs the real claude-opus-4-8 tool-use loop.
# When unset, the server boots and runs the deterministic mock planner (default, offline, seeded).
ANTHROPIC_API_KEY=

# Optional overrides:
# PORT=3000
# ANTHROPIC_MODEL=claude-opus-4-8
# PLANNER_MODE=auto        # auto | deterministic | agent  (auto = agent iff key present)
# WAYFARE_NOW=2026-06-16T10:00:00Z   # fixed clock for deterministic timestamps
